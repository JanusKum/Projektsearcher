[
 {
  "t0": 0.45,
  "t1": 2.6,
  "text": "Zwei Minuten Mikrowelle."
 },
 {
  "t0": 2.6,
  "t1": 4.6,
  "text": "Außen kochend heiß, in der Mitte eiskalt."
 },
 {
  "t0": 4.6,
  "t1": 6.5,
  "text": "Warum?"
 },
 {
  "t0": 6.7,
  "t1": 9.4,
  "text": "Schuld ist eine Welle, die stillsteht."
 },
 {
  "t0": 9.6,
  "t1": 11.4,
  "text": "Ohne Drehteller siehst du sie:"
 },
 {
  "t0": 11.4,
  "t1": 13.9,
  "text": "heiße Punkte und kalte Lücken."
 },
 {
  "t0": 14.0,
  "t1": 15.9,
  "text": "Immer sechs Zentimeter auseinander."
 },
 {
  "t0": 15.9,
  "t1": 18.1,
  "text": "Eine halbe Wellenlänge."
 },
 {
  "t0": 18.3,
  "t1": 20.6,
  "text": "Der Drehteller schiebt dein Essen durch diese Punkte."
 },
 {
  "t0": 20.6,
  "t1": 23.3,
  "text": "Nur die Mitte bewegt sich nicht."
 },
 {
  "t0": 23.5,
  "t1": 25.4,
  "text": "Darum bleibt sie kalt."
 },
 {
  "t0": 25.4,
  "t1": 28.6,
  "text": "Leg dein Essen als Ring, dann wird alles heiß."
 }
]