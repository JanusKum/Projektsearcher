[
 {
  "t0": 0.4,
  "t1": 2.2,
  "text": "Deine Kopfhörer machen Lärm."
 },
 {
  "t0": 2.2,
  "t1": 4.2,
  "text": "Damit du keinen hörst."
 },
 {
  "t0": 4.3,
  "t1": 7.6,
  "text": "Das ist der Lärm um dich herum: eine Schallwelle."
 },
 {
  "t0": 7.8,
  "t1": 9.6,
  "text": "Ein Mikrofon misst sie."
 },
 {
  "t0": 9.6,
  "t1": 11.6,
  "text": "Tausende Male pro Sekunde."
 },
 {
  "t0": 11.8,
  "t1": 14.0,
  "text": "Ein Chip baut daraus ihr Spiegelbild."
 },
 {
  "t0": 14.0,
  "t1": 16.6,
  "text": "Wo sie steigt, fällt seine."
 },
 {
  "t0": 16.9,
  "t1": 20.2,
  "text": "Beide zusammen ergeben: fast nichts."
 },
 {
  "t0": 20.6,
  "t1": 22.6,
  "text": "Nur hohe Töne sind zu schnell für den Chip."
 },
 {
  "t0": 22.6,
  "t1": 25.0,
  "text": "Die schluckt das Polster."
 },
 {
  "t0": 25.4,
  "t1": 27.2,
  "text": "Stille ist hier keine Ruhe."
 },
 {
  "t0": 27.2,
  "t1": 30.3,
  "text": "Sie ist Mathematik."
 }
]