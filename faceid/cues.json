  "text": "über Nase und Wangen verbiegt."
 },
 {
  "t0": 12.4,
  "t1": 15.9,
  "text": "Daraus baut ein Chip eine 3D-Karte deines Gesichts."
 },
 {
  "t0": 16.2,
  "t1": 19.0,
  "text": "Ein Foto? Ist flach. Abgelehnt."
 },
 {
  "t0": 19.4,
  "t1": 21.4,
  "text": "Dass ein Fremder dein Handy entsperrt:"
 },
 {
  "t0": 21.4,
  "t1": 23.8,
  "text": "eins zu einer Million."
 },
 {
  "t0": 24.0,
  "t1": 25.8,
  "text": "Du siehst es nie."
 },
 {
  "t0": 25.8,
  "t1": 28.2,
  "text": "Aber dein Handy sieht dich in 3D."
 }
