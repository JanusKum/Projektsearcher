[
 {
  "t0": 0.3,
  "t1": 2.8,
  "text": "Jedes Mal, wenn du entsperrst,"
 },
 {
  "t0": 2.8,
  "t1": 5.5,
  "text": "schießt dir dein Handy 30.000 Laserpunkte ins Gesicht."
 },
 {
  "t0": 5.7,
  "t1": 7.9,
  "text": "Unsichtbar. Infrarot."
 },
 {
  "t0": 8.1,
  "t1": 10.2,
  "text": "Eine Kamera sieht, wie sich das Muster"
 },
 {
  "t0": 10.2,
